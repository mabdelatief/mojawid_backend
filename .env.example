# Copy to .env for local overrides. Every setting is MOJAWID_<NAME> (app/config.py).
# The defaults already match the dev compose file, so .env is optional in dev.

MOJAWID_ENVIRONMENT=local
MOJAWID_DEBUG=true
MOJAWID_LOG_FORMAT=console
MOJAWID_DATABASE_URL=postgresql+asyncpg://mojawid:mojawid@localhost:5452/mojawid
