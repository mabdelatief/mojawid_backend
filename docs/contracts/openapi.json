{
  "components": {
    "schemas": {
      "AyahTiming": {
        "description": "One ayah's audio and where each word is in it.",
        "properties": {
          "audio_url": {
            "title": "Audio Url",
            "type": "string"
          },
          "ayah": {
            "title": "Ayah",
            "type": "integer"
          },
          "segments": {
            "description": "[first_word, last_word, start_ms, end_ms]. Word indexes are 0-based and inclusive into the ayah's words; a segment over several words is a merged span (a tap on any of them plays the span). A word in no segment isn't tappable for this reciter.",
            "items": {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            "title": "Segments",
            "type": "array"
          },
          "surah": {
            "title": "Surah",
            "type": "integer"
          }
        },
        "required": [
          "surah",
          "ayah",
          "audio_url",
          "segments"
        ],
        "title": "AyahTiming",
        "type": "object"
      },
      "ErrorPayload": {
        "description": "The body of an error response.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorPayload",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The error envelope.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorPayload"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Health": {
        "description": "The process is up.",
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "environment"
        ],
        "title": "Health",
        "type": "object"
      },
      "Ready": {
        "description": "The process can serve: the database answers.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Ready",
        "type": "object"
      },
      "Reciter": {
        "description": "A reciter the app can offer: every one has word-by-word timings.",
        "properties": {
          "audio_url_template": {
            "description": "Ayah audio URL with {surah:03d} and {ayah:03d} placeholders.",
            "examples": [
              "https://verseaudiofiles.eu-central-1.linodeobjects.com/Husary_64kbps/{surah:03d}{ayah:03d}.mp3"
            ],
            "title": "Audio Url Template",
            "type": "string"
          },
          "name_ar": {
            "title": "Name Ar",
            "type": "string"
          },
          "name_en": {
            "title": "Name En",
            "type": "string"
          },
          "slug": {
            "examples": [
              "husary"
            ],
            "title": "Slug",
            "type": "string"
          },
          "style": {
            "enum": [
              "murattal",
              "mujawwad",
              "muallim"
            ],
            "title": "Style",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name_ar",
          "name_en",
          "style",
          "audio_url_template"
        ],
        "title": "Reciter",
        "type": "object"
      },
      "ReciterList": {
        "description": "The reciters offered, and which one is the default.",
        "properties": {
          "default": {
            "title": "Default",
            "type": "string"
          },
          "reciters": {
            "items": {
              "$ref": "#/components/schemas/Reciter"
            },
            "title": "Reciters",
            "type": "array"
          }
        },
        "required": [
          "default",
          "reciters"
        ],
        "title": "ReciterList",
        "type": "object"
      },
      "ReciterTimings": {
        "description": "Timings for a run of ayat in one surah.",
        "properties": {
          "ayat": {
            "items": {
              "$ref": "#/components/schemas/AyahTiming"
            },
            "title": "Ayat",
            "type": "array"
          },
          "reciter": {
            "title": "Reciter",
            "type": "string"
          }
        },
        "required": [
          "reciter",
          "ayat"
        ],
        "title": "ReciterTimings",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Mojawid API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Liveness: no dependencies touched.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid API key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limited"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Readiness: the database answers a trivial query.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid API key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limited"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/reciters": {
      "get": {
        "description": "The reciters offered (all with word-by-word timings) and the default one.",
        "operationId": "list_reciters",
        "parameters": [
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          },
          {
            "in": "header",
            "name": "x-install-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Install-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReciterList"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid API key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limited"
          }
        },
        "summary": "List Reciters",
        "tags": [
          "reciters"
        ]
      }
    },
    "/v1/reciters/{slug}/timings": {
      "get": {
        "description": "Word timings and audio URLs for ayat `from`..`to` of `surah` (at most 20).",
        "operationId": "reciter_timings",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "surah",
            "required": true,
            "schema": {
              "maximum": 114,
              "minimum": 1,
              "title": "Surah",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "minimum": 1,
              "title": "From",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "minimum": 1,
              "title": "To",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          },
          {
            "in": "header",
            "name": "x-install-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Install-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReciterTimings"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid API key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limited"
          }
        },
        "summary": "Reciter Timings",
        "tags": [
          "reciters"
        ]
      }
    }
  }
}
